PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/ecommerce
JWT_SECRET=change_me
JWT_EXPIRES_IN=1hr
UPLOAD_DRIVER=
REDIS_URL=redis://127.0.0.1:6379

MAIL_DRIVER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Shop Name <no-reply@example.com>"
# Payments — set PAYMENT_DRIVER=stripe to enable online checkout.
# Leave it unset (and STRIPE_SECRET_KEY empty) to run as a COD-only shop.
PAYMENT_DRIVER=stripe
STRIPE_SECRET_KEY=sk_test_xxx
# Stripe test accounts usually do not support BDT presentment; develop on usd
# and flip this once the live account is confirmed.
STRIPE_CURRENCY=usd
# Stripe appends the real session id in place of {CHECKOUT_SESSION_ID}; that id
# is what the return handler verifies. It is added automatically if omitted.
STRIPE_SUCCESS_URL=http://localhost:3000/payments/stripe/return?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:3000/carts
# Where the customer's browser lands after the payment is verified. Point it at
# your frontend so they see a real page; leave it unset and the return route
# answers with JSON instead (handy in dev / for a pure API client).
PAYMENT_RETURN_REDIRECT_URL=http://localhost:5173/order-status
